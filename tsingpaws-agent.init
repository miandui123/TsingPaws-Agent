#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT=/opt/tsingpaws-agent/agent.py
ENV_FILE=/etc/tsingpaws-agent.env
WRAPPER=/opt/tsingpaws-agent/run.sh

start_service() {
	[ -x "$PROG" ] || return 1
	[ -f "$SCRIPT" ] || return 1
	[ -f "$ENV_FILE" ] || return 1
	[ -x "$WRAPPER" ] || return 1

	procd_open_instance
	procd_set_param command "$WRAPPER"
	procd_set_param file "$ENV_FILE" "$SCRIPT" "$WRAPPER"
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/tsingpaws-agent.pid
	procd_close_instance
}

reload_service() {
	stop
	start
}
