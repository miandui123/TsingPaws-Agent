#!/bin/sh /etc/rc.common
START=99
STOP=9
USE_PROCD=1

PROG=/usr/bin/python3
SCRIPT=/opt/tsingpaws-agent/launcher_bridge.py
WRAPPER=/opt/tsingpaws-agent/run-bridge.sh

start_service() {
	[ -x "$PROG" ] || return 1
	[ -f "$SCRIPT" ] || return 1
	[ -x "$WRAPPER" ] || return 1
	procd_open_instance
	procd_set_param command "$WRAPPER"
	procd_set_param file "$SCRIPT" "$WRAPPER"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/tsingpaws-bridge.pid
	procd_close_instance
}

reload_service() {
	stop
	start
}
